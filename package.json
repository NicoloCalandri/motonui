{
  "name": "motonui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "check:bundle": "node scripts/check-client-bundle.mjs",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:pages": "vitest run src/app",
    "test:mobile": "vitest run --root mobile",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:rls": "sh scripts/run-sql-tests.sh",
    "predev": "npm test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:seed": "supabase db push --local && psql -h 127.0.0.1 -p 54322 -U postgres -d postgres -f supabase/seed.sql",
    "db:diff": "supabase db diff",
    "storage:migrate-boarding-passes": "tsx scripts/migrate-boarding-passes.ts",
    "db:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts",
    "setup": "node -e \"const fs = require('fs'); if (!fs.existsSync('.env.local')) fs.copyFileSync('.env.example', '.env.local');\" && npm install"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@hookform/resolvers": "^5.9.1",
    "@sentry/nextjs": "^11.16.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "@tiptap/core": "^3.35.0",
    "@tiptap/extension-image": "^3.35.0",
    "@tiptap/extension-link": "^3.35.0",
    "@tiptap/html": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/react": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "@vercel/speed-insights": "^2.1.0",
    "date-fns": "^4.4.0",
    "exifr": "^7.1.3",
    "fflate": "^0.8.2",
    "happy-dom": "^21.0.4",
    "jose": "^6.2.18",
    "lucide-react": "^1.76.0",
    "mapbox-gl": "^3.35.1",
    "motion": "^14.14.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-dropzone": "^20.2.1",
    "react-hook-form": "^7.92.0",
    "recharts": "^3.11.0",
    "resend": "^6.39.0",
    "sharp": "^0.35.5",
    "swr": "^2.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/mapbox-gl": "^3.5.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "autoprefixer": "^10.6.2",
    "axe-core": "^4.14.1",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.4.6",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.33",
    "supabase": "^2.121.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "postcss": "$postcss",
    "source-map-js": "^1.2.2"
  }
}
