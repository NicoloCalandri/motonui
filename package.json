{
  "name": "motonui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:pages": "vitest run src/app",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:rls": "sh scripts/run-sql-tests.sh",
    "predev": "npm test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:seed": "supabase db push --local && psql -h 127.0.0.1 -p 54322 -U postgres -d postgres -f supabase/seed.sql",
    "db:diff": "supabase db diff",
    "storage:migrate-boarding-passes": "tsx scripts/migrate-boarding-passes.ts",
    "db:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts",
    "setup": "node -e \"const fs = require('fs'); if (!fs.existsSync('.env.local')) fs.copyFileSync('.env.example', '.env.local');\" && npm install"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@hookform/resolvers": "^3.9.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@sentry/nextjs": "^10.43.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@tiptap/extension-image": "^2.8.0",
    "@tiptap/extension-link": "^2.8.0",
    "@tiptap/html": "^2.27.2",
    "@tiptap/react": "^2.8.0",
    "@tiptap/starter-kit": "^2.8.0",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "date-fns": "^4.4.0",
    "exifr": "^7.1.3",
    "fflate": "^0.8.2",
    "jose": "^6.2.12",
    "jszip": "^3.10.2",
    "lucide-react": "^0.454.0",
    "mapbox-gl": "^3.32.0",
    "next": "^15.5.18",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-dropzone": "^14.2.0",
    "react-hook-form": "^7.89.0",
    "react-map-gl": "^7.1.0",
    "react-masonry-css": "^1.0.16",
    "recharts": "^2.13.0",
    "resend": "^6.32.0",
    "sharp": "^0.35.5",
    "swr": "^2.5.1",
    "tailwind-merge": "^2.5.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/mapbox-gl": "^3.5.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.6.1",
    "axe-core": "^4.13.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "jsdom": "^28.1.0",
    "postcss": "^8.5.29",
    "supabase": "^2.119.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "postcss": "$postcss",
    "source-map-js": "^1.2.2"
  }
}
