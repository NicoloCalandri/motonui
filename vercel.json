{
    "buildCommand": "npm run build",
    "outputDirectory": ".next",
    "framework": "nextjs",
    "git": {
        "deploymentEnabled": {
            "main": false
        }
    },
    "regions": [
        "fra1"
    ],
    "crons": [
        {
            "path": "/api/admin/send-reminders",
            "schedule": "0 8 * * *"
        },
        {
            "path": "/api/admin/cleanup",
            "schedule": "0 3 * * *"
        }
    ],
    "rewrites": [
        {
            "source": "/sitemap.xml",
            "destination": "/api/sitemap"
        }
    ]
}
