{
  "name": "@motonui/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc --noEmit && esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --alias:@motonui/shared-types=../../packages/shared-types/src/index.ts --sourcemap --outfile=dist/index.js",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@hono/node-server": "^1.13.7",
    "@motonui/shared-types": "*",
    "@sentry/node": "^11.7.0",
    "@supabase/supabase-js": "^2.117.2",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/html": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "exifr": "^7.1.3",
    "fflate": "^0.8.2",
    "happy-dom": "^20.14.6",
    "hono": "^4.13.11",
    "jose": "^6.2.12",
    "jszip": "^3.10.2",
    "node-cron": "^4.6.0",
    "resend": "^6.32.0",
    "sharp": "^0.35.5",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/node-cron": "^3.0.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vitest": "^5.0.3"
  }
}
