SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_IMPERSONATION_SECRET=
ADMIN_AUTH_BYPASS=false
# At least 32 characters. Sent by the scheduler as "Authorization: Bearer <value>" to the cron routes.
CRON_SECRET=
# Origins of the web app allowed by CORS and for writes, comma separated (e.g. https://motonui.app).
WEB_ORIGIN=
ENABLE_CRON=false
PORT=3001

# Used by the library modules ported from src/lib (same names as the root .env.example).
# Email (reminders, invites). Without the key nothing is sent and the reminders job does nothing.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# AI routes. Without the key every AI call fails after consuming quota: set it or disable the features.
ANTHROPIC_API_KEY=
# Currency conversion. Without the key non-EUR expenses stay "to be converted" (amount_eur null).
EXCHANGE_RATE_API_KEY=
# Public URL of the web app, used in links built by the server (invites, blog).
NEXT_PUBLIC_APP_URL=

# Error tracking (optional): without it errors are only logged
SENTRY_DSN=
