# ─────────────────────────────────────────────
# motonui — Environment Variables
# Copy this to .env.local and fill in your keys
# ─────────────────────────────────────────────

# ── Supabase ──────────────────────────────────
# Get from: https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # ⚠️ Never expose client-side

# ── Mapbox ────────────────────────────────────
# Get from: https://account.mapbox.com/access-tokens
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1...

# ── Anthropic (Claude AI) ─────────────────────
# Get from: https://console.anthropic.com/api-keys
ANTHROPIC_API_KEY=sk-ant-...                      # ⚠️ Never expose client-side

# ── Exchange Rate API ─────────────────────────
# Free tier: https://www.exchangerate-api.com
EXCHANGE_RATE_API_KEY=your-key

# ── Sentry (Error Monitoring) — optional ──────
# Get from: https://sentry.io
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
SENTRY_AUTH_TOKEN=sntrys_...

# ── App ───────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=motonui
