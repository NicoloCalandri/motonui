# ─────────────────────────────────────────────
# motonui — Environment Variables
# Copy this to .env.local and fill in your keys.
# Never commit real values: .env* files are git-ignored (except this one)
# and gitleaks runs in pre-commit and CI.
# ─────────────────────────────────────────────

# ── Supabase ──────────────────────────────────
# Local development: `supabase start` prints these values.
# Cloud: https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # ⚠️ Server only, never NEXT_PUBLIC_

# ── Mapbox ────────────────────────────────────
# Get from: https://account.mapbox.com/access-tokens
# Restrict the token to your domains (URL restrictions) in the Mapbox dashboard.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-token

# ── Anthropic (Claude AI) — optional ──────────
# Get from: https://console.anthropic.com/api-keys
ANTHROPIC_API_KEY=your-anthropic-api-key   # ⚠️ Server only

# ── Exchange Rate API — optional ──────────────
# Free tier: https://www.exchangerate-api.com
EXCHANGE_RATE_API_KEY=your-exchange-rate-key

# ── Sentry (Error Monitoring) — optional ──────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ── App ───────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=motonui

# ── Admin ─────────────────────────────────────
# JWT secret for impersonation tokens — min 32 chars, different per environment.
# Generate with: openssl rand -base64 32
ADMIN_IMPERSONATION_SECRET=generate-with-openssl-rand-base64-32   # ⚠️ Server only
# Bypasses admin auth in API routes (requireAdmin()) and the admin
# layout check — LOCAL DEVELOPMENT ONLY. The middleware's own
# role-based /admin redirect still applies regardless of this flag.
# Never set this in staging or production: `next build` / `next start` refuse
# to run with it when NODE_ENV or VERCEL_ENV is production (T-1.10).
# ADMIN_AUTH_BYPASS=true
